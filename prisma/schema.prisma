// ─────────────────────────────────────────────────────────────────────────────
// prisma/schema.prisma
// Production PostgreSQL Prisma Schema for FasalDost Modular Monolith
// ─────────────────────────────────────────────────────────────────────────────

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  farmer
  buyer
  agronomist
  admin
}

enum VerificationStatus {
  unverified
  pending
  verified
  rejected
}

enum ListingStatus {
  active
  pending
  sold
  archived
}

model User {
  id            String          @id @default(uuid())
  uid           String          @unique
  email         String?         @unique
  phone         String?
  displayName   String?
  photoUrl      String?
  role          Role            @default(farmer)
  passwordHash  String?
  language      String          @default("en")
  status        String          @default("active")
  lastLoginAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  farmerProfile FarmerProfile?
  scans         DiagnosticScan[]
  listings      MarketplaceListing[]

  accounts       Account[]
  orgMemberships OrganizationMember[]
  offers         Offer[]
  orders         Order[]
  walletAccounts WalletAccount[]
  payoutsReceived Payout[]
  verifications  Verification[]
  disputesRaised Dispute[]
  auditLogs      AuditLog[]
  cropScans      CropScan[]

  @@map("users")
}

model FarmerProfile {
  id                        String              @id @default(uuid())
  userId                    String              @unique
  user                      User                @relation(fields: [userId], references: [uid], onDelete: Cascade)
  fullName                  String
  phoneNumber               String
  email                     String?
  profilePhotoUrl           String?
  cnicNumber                String?
  cnicFrontUrl              String?
  cnicBackUrl               String?
  province                  String              @default("Punjab")
  division                  String?
  district                  String?
  tehsil                    String?
  village                   String?
  landSizeAcres             String?
  preferredLanguage         String              @default("en")
  primaryCrops              String[]            @default([])
  verifiedStatus            Boolean             @default(false)
  isSellerVerified          Boolean             @default(false)
  sellerVerificationStatus  VerificationStatus  @default(unverified)
  antiBotVerificationScore  String?
  aiVerificationConfidence  String?
  aiVerificationNotes       String?
  verificationIssues        String[]            @default([])
  verifiedSellerBadge       String?
  rejectedReason            String?
  reviewedBy                String?
  verifiedAt                DateTime?
  farmerType                String?
  dateOfBirth               DateTime?           @db.Date
  cnicVerified              Boolean             @default(false)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  farms                     Farm[]
  listings                  Listing[]
  settlements               Settlement[]

  @@map("farmer_profiles")
}

model DiagnosticScan {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [uid], onDelete: Cascade)
  cropName          String
  imageUrl          String
  s3Key             String?
  isHealthy         Boolean   @default(false)
  confidenceScore   Decimal   @db.Decimal(5, 4)
  primaryDisease    String?
  detectedDiseases  Json      @default("[]")
  treatmentPlan     Json      @default("{}")
  preventionAdvice  Json      @default("[]")
  symptomsObserved  Json      @default("[]")
  processingTimeMs  Int?
  scanDate          DateTime  @default(now())
  createdAt         DateTime  @default(now())

  @@index([userId, scanDate])
  @@index([cropName])
  @@map("diagnostic_scans")
}

model MarketplaceListing {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [uid], onDelete: Cascade)
  sellerName      String
  sellerPhone     String
  sellerEmail     String?
  cropName        String
  variety         String?
  quantity        Decimal        @db.Decimal(10, 2)
  unit            String         @default("KG")
  price           Decimal        @db.Decimal(12, 2)
  qualityGrade    String?        @default("standard")
  harvestDate     DateTime?
  description     String?
  province        String
  district        String?
  tehsil          String?
  images          String[]       @default([])
  videos          String[]       @default([])
  status          ListingStatus  @default(active)
  isVerifiedSeller Boolean       @default(false)
  viewsCount      Int            @default(0)
  inquiriesCount  Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([cropName, status])
  @@index([province, district])
  @@map("marketplace_listings")
}

model JobExecution {
  id          String    @id @default(uuid())
  queueName   String
  jobId       String    @unique
  name        String
  data        Json
  status      String    @default("pending")
  attempts    Int       @default(0)
  result      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@map("job_executions")
}

// ═════════════════════════════════════════════════════════════════════════════
// Agrifoods ERD — new modules (1–9). Existing models above are kept as-is.
// NOTE: `Listing` (ERD) is separate from legacy `MarketplaceListing`.
// ═════════════════════════════════════════════════════════════════════════════

// ── 1. Identity & Access ─────────────────────────────────────────────────────
model Account {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("accounts")
}

model Organization {
  id                 String   @id @default(uuid())
  name               String
  type               String
  registrationNumber String?
  address            String?
  status             String   @default("active")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  members OrganizationMember[]

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String
  status         String       @default("active")
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_members")
}

// ── 2. Farmer & Farm ─────────────────────────────────────────────────────────
model Farm {
  id            String   @id @default(uuid())
  farmerId      String
  farmer        FarmerProfile @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  name          String
  latitude      Float?
  longitude     Float?
  address       String?
  areaSize      Decimal? @db.Decimal(10, 2)
  ownershipType String?
  irrigationType String?
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cropCycles CropCycle[]
  scans      CropScan[]

  @@index([farmerId])
  @@map("farms")
}

model Crop {
  id          String   @id @default(uuid())
  name        String
  category    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cropCycles CropCycle[]
  listings   Listing[]
  lots       InventoryLot[]
  scans      CropScan[]
  diseases   Disease[]

  @@map("crops")
}

model CropCycle {
  id                  String    @id @default(uuid())
  farmId              String
  farm                Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  fieldId             String?
  cropId              String
  crop                Crop      @relation(fields: [cropId], references: [id])
  variety             String?
  plantingDate        DateTime? @db.Date
  expectedHarvestDate DateTime? @db.Date
  actualHarvestDate   DateTime? @db.Date
  status              String    @default("planned")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([farmId])
  @@index([cropId])
  @@map("crop_cycles")
}

// ── 3. Marketplace ───────────────────────────────────────────────────────────
model Listing {
  id             String    @id @default(uuid())
  farmerId       String
  farmer         FarmerProfile @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  cropId         String?
  crop           Crop?     @relation(fields: [cropId], references: [id])
  title          String
  description    String?
  quantity       Decimal   @db.Decimal(12, 2)
  unit           String
  pricePerUnit   Decimal   @db.Decimal(12, 2)
  qualityGrade   String?
  availableFrom  DateTime? @db.Date
  availableUntil DateTime? @db.Date
  status         String    @default("active")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  images     ListingImage[]
  offers     Offer[]
  orders     Order[]
  orderItems OrderItem[]

  @@index([farmerId])
  @@index([cropId, status])
  @@map("listings")
}

model ListingImage {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  imageUrl  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([listingId])
  @@map("listing_images")
}

model Offer {
  id         String    @id @default(uuid())
  listingId  String
  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId    String
  buyer      User      @relation(fields: [buyerId], references: [id])
  offerPrice Decimal   @db.Decimal(12, 2)
  quantity   Decimal   @db.Decimal(12, 2)
  status     String    @default("pending")
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([listingId])
  @@index([buyerId])
  @@map("offers")
}

// ── 4. Orders & Logistics ────────────────────────────────────────────────────
model Order {
  id                   String    @id @default(uuid())
  buyerId              String
  buyer                User      @relation(fields: [buyerId], references: [id])
  listingId            String?
  listing              Listing?  @relation(fields: [listingId], references: [id])
  totalAmount          Decimal   @db.Decimal(14, 2)
  status               String    @default("pending")
  deliveryAddress      String?
  expectedDeliveryDate DateTime? @db.Date
  actualDeliveryDate   DateTime? @db.Date
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  items       OrderItem[]
  shipments   Shipment[]
  settlements Settlement[]
  disputes    Dispute[]

  @@index([buyerId, status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id])
  quantity   Decimal  @db.Decimal(12, 2)
  unitPrice  Decimal  @db.Decimal(12, 2)
  totalPrice Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@index([listingId])
  @@map("order_items")
}

model LogisticsProvider {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  type      String?
  status    String   @default("active")
  createdAt DateTime @default(now())

  shipments   Shipment[]
  settlements Settlement[]

  @@map("logistics_providers")
}

model Shipment {
  id                  String             @id @default(uuid())
  orderId             String
  order               Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  logisticsProviderId String?
  logisticsProvider   LogisticsProvider? @relation(fields: [logisticsProviderId], references: [id])
  trackingNumber      String?            @unique
  status              String             @default("pending")
  pickupLocation      String?
  deliveryLocation    String?
  dispatchedAt        DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime           @default(now())

  events DeliveryEvent[]

  @@index([orderId])
  @@index([logisticsProviderId])
  @@map("shipments")
}

model DeliveryEvent {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     String
  location   String?
  timestamp  DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([shipmentId, timestamp])
  @@map("delivery_events")
}

// ── 5. Inventory & Warehouse ─────────────────────────────────────────────────
model Warehouse {
  id        String   @id @default(uuid())
  name      String
  location  String?
  capacity  Decimal? @db.Decimal(12, 2)
  type      String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lots      InventoryLot[]
  movements StockMovement[]

  @@map("warehouses")
}

model InventoryLot {
  id           String    @id @default(uuid())
  warehouseId  String
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  cropId       String
  crop         Crop      @relation(fields: [cropId], references: [id])
  quantity     Decimal   @db.Decimal(12, 2)
  unit         String
  qualityGrade String?
  receivedAt   DateTime  @default(now())
  expiryDate   DateTime? @db.Date
  status       String    @default("in_stock")
  createdAt    DateTime  @default(now())

  movements StockMovement[]

  @@index([warehouseId])
  @@index([cropId])
  @@map("inventory_lots")
}

model StockMovement {
  id           String       @id @default(uuid())
  inventoryLotId String
  inventoryLot InventoryLot @relation(fields: [inventoryLotId], references: [id])
  warehouseId  String
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])
  type         String
  quantity     Decimal      @db.Decimal(12, 2)
  referenceId  String?
  notes        String?
  createdAt    DateTime     @default(now())

  @@index([inventoryLotId])
  @@index([warehouseId, createdAt])
  @@map("stock_movements")
}

// ── 6. Finance & Settlements (Ledger) ────────────────────────────────────────
model WalletAccount {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  accountType String
  balance     Decimal  @default(0) @db.Decimal(16, 2)
  currency    String   @default("PKR")
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions LedgerTransaction[]
  entries      LedgerEntry[]

  @@index([userId])
  @@map("wallet_accounts")
}

model LedgerTransaction {
  id          String        @id @default(uuid())
  walletId    String
  wallet      WalletAccount @relation(fields: [walletId], references: [id])
  type        String
  amount      Decimal       @db.Decimal(16, 2)
  currency    String        @default("PKR")
  description String?
  referenceId String?
  status      String        @default("posted")
  createdAt   DateTime      @default(now())

  entries LedgerEntry[]

  @@index([walletId, createdAt])
  @@index([referenceId])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String            @id @default(uuid())
  transactionId String
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id])
  accountId     String
  account       WalletAccount     @relation(fields: [accountId], references: [id])
  entryType     String            // debit | credit
  amount        Decimal           @db.Decimal(16, 2)
  balanceAfter  Decimal           @db.Decimal(16, 2)
  description   String?
  createdAt     DateTime          @default(now())

  @@index([transactionId])
  @@index([accountId, createdAt])
  @@map("ledger_entries")
}

model Settlement {
  id                  String             @id @default(uuid())
  orderId             String
  order               Order              @relation(fields: [orderId], references: [id])
  farmerId            String
  farmer              FarmerProfile      @relation(fields: [farmerId], references: [id])
  logisticsProviderId String?
  logisticsProvider   LogisticsProvider? @relation(fields: [logisticsProviderId], references: [id])
  platformFee         Decimal            @db.Decimal(14, 2)
  farmerAmount        Decimal            @db.Decimal(14, 2)
  logisticsAmount     Decimal?           @db.Decimal(14, 2)
  status              String             @default("pending")
  releaseDate         DateTime?
  createdAt           DateTime           @default(now())

  payouts Payout[]

  @@index([orderId])
  @@index([farmerId])
  @@map("settlements")
}

model Payout {
  id                   String     @id @default(uuid())
  settlementId         String
  settlement           Settlement @relation(fields: [settlementId], references: [id])
  recipientId          String
  recipient            User       @relation(fields: [recipientId], references: [id])
  amount               Decimal    @db.Decimal(14, 2)
  method               String
  status               String     @default("pending")
  transactionReference String?
  createdAt            DateTime   @default(now())

  @@index([settlementId])
  @@index([recipientId])
  @@map("payouts")
}

// ── 7. Verifications & Trust ─────────────────────────────────────────────────
model Verification {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  status     String    @default("pending")
  documents  Json      @default("[]")
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, type])
  @@map("verifications")
}

model Dispute {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  raisedById  String
  raisedBy    User     @relation(fields: [raisedById], references: [id])
  type        String
  description String?
  status      String   @default("open")
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([raisedById])
  @@map("disputes")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  details    Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ── 9. Reference / Lookup ────────────────────────────────────────────────────
model CropCategory {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  @@map("crop_categories")
}

model Unit {
  id     String @id @default(uuid())
  name   String @unique
  symbol String

  @@map("units")
}

model RoleRef {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  @@map("roles")
}

model Country {
  id   String @id @default(uuid())
  name String
  code String @unique

  @@map("countries")
}

// ═════════════════════════════════════════════════════════════════════════════
// 10. Crop scans — HIGH VOLUME (target ~10M scans/day, ~3.65B/year)
// Rules for these tables:
//  * Images are NEVER stored in Postgres. Only the object-storage key is kept.
//  * All four scan tables are RANGE-partitioned by "scannedAt" (daily).
//    Prisma cannot express partitions: after `prisma migrate dev --create-only`
//    run `node scripts/partitionize-migration.mjs <migration.sql>` (see docs/SCAN_STORAGE.md).
//  * Every PK/unique index must contain "scannedAt" (Postgres partition rule).
//  * Keep secondary indexes minimal: each one multiplies write cost at this volume.
// ═════════════════════════════════════════════════════════════════════════════
model Disease {
  id             String   @id @default(uuid())
  cropId         String?
  crop           Crop?    @relation(fields: [cropId], references: [id])
  name           String
  scientificName String?
  category       String   // fungal | bacterial | viral | pest | nutrient | healthy
  createdAt      DateTime @default(now())

  scans     CropScan[]
  diagnoses ScanDiagnosis[]
  contents  DiseaseContent[]
  samples   DatasetSample[]

  @@unique([cropId, name])
  @@map("diseases")
}

model CropScan {
  id               String    @default(uuid(7)) @db.Uuid
  scannedAt        DateTime  @default(now()) @db.Timestamptz(3)
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  cropId           String
  crop             Crop      @relation(fields: [cropId], references: [id])
  farmId           String?
  farm             Farm?     @relation(fields: [farmId], references: [id])
  geohash          String?   @db.VarChar(8)
  latitude         Float?
  longitude        Float?
  status           String    @default("completed") @db.VarChar(16) // pending | processing | completed | failed
  modelVersion     String    @db.VarChar(32)
  source           String?   @db.VarChar(16)                       // mobile | web
  isHealthy        Boolean?
  healthScore      Decimal?  @db.Decimal(5, 4)
  topDiseaseId     String?
  topDisease       Disease?  @relation(fields: [topDiseaseId], references: [id])
  topConfidence    Decimal?  @db.Decimal(5, 4)
  severity         Int?      @db.SmallInt
  processingTimeMs Int?
  trainingConsent  Boolean   @default(false)                      // user agreed their image may train models
  labelStatus      String    @default("ai_predicted") @db.VarChar(16) // ai_predicted | user_confirmed | expert_verified | rejected
  meta             Json?                                           // device, app version, capture conditions

  images    ScanImage[]
  diagnoses ScanDiagnosis[]
  report    ScanReport?

  @@id([id, scannedAt])
  @@index([userId, scannedAt(sort: Desc)])
  @@index([cropId, scannedAt])
  @@index([topDiseaseId, scannedAt])
  @@map("crop_scans")
}

model ScanImage {
  id         String   @default(uuid(7)) @db.Uuid
  scanId     String   @db.Uuid
  scannedAt  DateTime @db.Timestamptz(3)
  scan       CropScan @relation(fields: [scanId, scannedAt], references: [id, scannedAt], onDelete: Cascade)
  kind       String   @default("original") @db.VarChar(16) // original | thumbnail | annotated | heatmap
  storageKey String   // object-storage key, e.g. scans/2026/10/06/<scanId>/original.webp
  mimeType   String   @db.VarChar(32)
  widthPx    Int?
  heightPx   Int?
  sizeBytes  Int?
  sha256     String?  @db.Char(64)

  @@id([id, scannedAt])
  @@index([scanId, scannedAt])
  @@map("scan_images")
}

model ScanDiagnosis {
  id              String   @default(uuid(7)) @db.Uuid
  scanId          String   @db.Uuid
  scannedAt       DateTime @db.Timestamptz(3)
  scan            CropScan @relation(fields: [scanId, scannedAt], references: [id, scannedAt], onDelete: Cascade)
  diseaseId       String
  disease         Disease  @relation(fields: [diseaseId], references: [id])
  confidence      Decimal  @db.Decimal(5, 4)
  severity        Int?     @db.SmallInt
  affectedAreaPct Decimal? @db.Decimal(5, 2)
  bbox            Json?

  @@id([id, scannedAt])
  @@index([scanId, scannedAt])
  @@index([diseaseId, scannedAt])
  @@map("scan_diagnoses")
}

model ScanReport {
  scanId           String   @db.Uuid
  scannedAt        DateTime @db.Timestamptz(3)
  scan             CropScan @relation(fields: [scanId, scannedAt], references: [id, scannedAt], onDelete: Cascade)
  language         String   @default("en") @db.VarChar(8)
  summary          String?
  symptoms         Json     @default("[]")
  treatmentPlan    Json     @default("{}")
  preventionAdvice Json     @default("[]")
  rawOutputKey     String?  // full raw model output kept in object storage, not in Postgres

  @@id([scanId, scannedAt])
  @@map("scan_reports")
}

// ── 10b. Disease knowledge base + permanent labeled dataset ──────────────────
// DiseaseContent is YOUR OWN curated text (description, causes, treatment, advice).
// Once the AI is removed from the backend, results are served from here.
// DatasetSample and ScanFeedback have NO foreign key to the partitioned scan tables:
// scan partitions are archived over time, the dataset must never depend on them.
model DiseaseContent {
  id          String   @id @default(uuid())
  diseaseId   String
  disease     Disease  @relation(fields: [diseaseId], references: [id], onDelete: Cascade)
  language    String   @db.VarChar(8)
  version     Int      @default(1)
  description String
  causes      String?
  symptoms    Json     @default("[]")
  treatment   Json     @default("{}") // { organic: [], chemical: [], cultural: [] }
  prevention  Json     @default("[]")
  advice      String?
  reviewedBy  String?                 // agronomist who approved this text
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([diseaseId, language, version])
  @@index([diseaseId, language, isPublished])
  @@map("disease_contents")
}

model ScanFeedback {
  id                 String   @id @default(uuid(7)) @db.Uuid
  scanId             String   @db.Uuid
  scannedAt          DateTime @db.Timestamptz(3)
  userId             String
  isCorrect          Boolean
  correctedDiseaseId String?
  note               String?
  createdAt          DateTime @default(now())

  @@index([scanId])
  @@index([userId, createdAt])
  @@map("scan_feedback")
}

model DatasetSample {
  id             String   @id @default(uuid(7)) @db.Uuid
  scanId         String   @db.Uuid     // origin scan, plain column (no FK)
  scannedAt      DateTime @db.Timestamptz(3)
  storageKey     String                // image object, tagged retain=permanent, never expired
  sha256         String   @unique @db.Char(64) // exact-duplicate guard
  phash          String?  @db.Char(16)         // near-duplicate guard
  cropId         String
  diseaseId      String
  disease        Disease  @relation(fields: [diseaseId], references: [id])
  labelSource    String   @db.VarChar(16)      // ai | user | expert
  labelStatus    String   @db.VarChar(16)      // user_confirmed | expert_verified
  confidence     Decimal? @db.Decimal(5, 4)
  split          String   @default("train") @db.VarChar(8) // train | val | test, fixed by hash, never reshuffled
  geohash        String?  @db.VarChar(5)       // coarse location only, no user id stored
  embedding      Unsupported("vector(512)")?   // pgvector, for similarity matching
  embeddingModel String?  @db.VarChar(32)
  meta           Json?
  createdAt      DateTime @default(now())

  @@index([diseaseId, split])
  @@index([cropId, diseaseId])
  @@map("dataset_samples")
}
